# Server-side only (never prefixed with VITE_, so it is not bundled into the browser)
OPENAI_API_KEY=sk-...
# Optional: any chat model that supports structured outputs
OPENAI_MODEL=gpt-4.1-mini

# Optional: live city autocomplete (https://myprojects.geoapify.com). Without it,
# a built-in list of popular destinations is used.
VITE_GEOAPIFY_API_KEY=
